{
  "name": "hello-typescript-vitest",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --project unit --project browser --silent",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vrt:server": "sh scripts/vrt-server.sh",
    "vrt:server:stop": "sh scripts/vrt-server.sh stop",
    "test:visual": "vitest run --project vrt",
    "test:visual:update": "vitest run --project vrt --update"
  },
  "author": "",
  "license": "Unlicense",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "tinyexec": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "//": "FIXME: ESLint 側が minimatch 11 系を受け付けたら overrides を消す（eslint/eslint#21463）",
